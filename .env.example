# ==============================================================================
# ORS Deployment Environment Configuration (.env)
# Copy this file to .env and adjust values for your environment (Local / AWS)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AWS Cloud Configuration (Used for deployment scripts & ECR)
# ------------------------------------------------------------------------------
AWS_REGION=ap-southeast-1
AWS_ACCOUNT_ID=123456789012
IMAGE_TAG=latest

# ------------------------------------------------------------------------------
# 2. Database Configuration (MySQL 8 / Amazon RDS)
# ------------------------------------------------------------------------------
# Local Docker uses 'ors-db:3306', AWS RDS uses e.g. 'ors-mysql.xxxx.ap-southeast-1.rds.amazonaws.com:3306'
DB_HOST=ors-db
DB_PORT=3306
DB_NAME=orsdb
DB_USER=root
DB_ROOT_PASSWORD=ors2026

# Spring Boot JDBC connection string
SPRING_DATASOURCE_URL=jdbc:mysql://${DB_HOST}:${DB_PORT}/${DB_NAME}?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=${DB_USER}
SPRING_DATASOURCE_PASSWORD=${DB_ROOT_PASSWORD}

# Database Connection Pool Tuning
DB_POOL_MAX=20
DB_POOL_MIN_IDLE=5
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# ------------------------------------------------------------------------------
# 3. Backend Security & Server Settings (Spring Boot)
# ------------------------------------------------------------------------------
SERVER_PORT=8080
# Generate a secure 256-bit (64 hex characters) secret for production JWT signing
APP_JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
APP_JWT_EXPIRATION_MS=86400000

# ------------------------------------------------------------------------------
# 4. Frontend Settings (Next.js)
# ------------------------------------------------------------------------------
PORT=3000
# Internal Docker / ECS URL where Next.js proxies API requests server-side
BACKEND_API_URL=http://ors-server:8080

# Public URL used by client browsers to call backend (leave empty if using Next.js /api proxy rewrite)
NEXT_PUBLIC_BASE_API=http://localhost:8080

